{
  "name": "oylab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --filter site dev",
    "dev:admin": "bun run --filter admin dev",
    "build": "bun run --filter site build",
    "build:admin": "bun run --filter admin build",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "preview": "bun run --filter site preview",
    "deploy": "bun run --filter site deploy",
    "wrangler": "bun run --cwd apps/site wrangler"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "better-sqlite3",
    "workerd"
  ]
}
