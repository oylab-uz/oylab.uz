# Copy to .env on the box (or .env.local for development). Never commit real values.

# Cloudflare Access application protecting admin.oylab.uz (Zero Trust > Access > Applications)
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUD=application-audience-tag

# R2 bucket "oylab-media", S3 API token (R2 > Manage API tokens), public on media.oylab.uz
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oylab-media
MEDIA_PUBLIC_URL=https://media.oylab.uz

# Workers Builds deploy hook for the site Worker "oylab" (Settings > Builds > Deploy Hooks)
DEPLOY_HOOK_URL=

# Where the SQLite file lives (a Docker volume in production)
DATABASE_PATH=/data/oylab.sqlite

# Development only: identity used when no Cloudflare Access token is present
ADMIN_DEV_EMAIL=dev@oylab.uz
