{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oylab",
  // Assets-only Worker: no "main", so page views never run Worker code and
  // never count as invocations. Phase 2 adds "main" plus run_worker_first
  // for /api/* only.
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "out",
    // /uz -> out/uz.html or out/uz/index.html, no trailing slash in URLs.
    "html_handling": "auto-trailing-slash",
    // Serves the nearest 404.html up the path: out/uz/404.html for /uz/*.
    "not_found_handling": "404-page"
  },
  // The site must only be reachable on its own hostname. The workers.dev
  // hostname would duplicate content. Flip workers_dev to true for a one-off
  // test before the zone is active, together with removing "routes".
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "oylab.uz", "custom_domain": true }]
}
