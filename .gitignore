# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# serena (local code-intelligence config)
.serena/

# cloudflare (OpenNext build output, wrangler state, generated binding types)
.open-next/
.wrangler/
cloudflare-env.d.ts

# git worktrees for feature branches
.worktrees/

# graphify local state (graph.json, graph.html, GRAPH_REPORT.md and resolve_imports.py are committed)
/graphify-out/cache/
/graphify-out/manifest.json
/graphify-out/cost.json
/graphify-out/.graphify_*

# scratch: plan workspaces, probe scripts, local wrangler logs
.superpowers/
.wrangler/
.wrangler-dev.log
